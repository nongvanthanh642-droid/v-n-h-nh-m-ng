<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AX1800 Pro Remote SSH Controller"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Khởi tạo phiên..."
            android:textColor="#38BDF8"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone" />

        <!-- 1. CELL LOCK BTS -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="1. Khóa Sóng Trạm BTS (Cell Lock)"
            android:textColor="#06B6D4"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etEarfcn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#1E293B"
                android:hint="EARFCN (vd: 1850)"
                android:padding="10dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#64748B"
                android:textSize="12sp" />

            <View
                android:layout_width="8dp"
                android:layout_height="0dp" />

            <EditText
                android:id="@+id/etPci"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#1E293B"
                android:hint="PCI (vd: 124)"
                android:padding="10dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#64748B"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnLockBts"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="#0891B2"
                android:text="🔒 Bắn Lệnh Khóa BTS"
                android:textSize="12sp" />

            <View
                android:layout_width="8dp"
                android:layout_height="0dp" />

            <Button
                android:id="@+id/btnCheckSignal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="#334155"
                android:text="📶 Đọc Sóng 4G"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 2. MA TRẬN NEKOBOX -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="2. Ma Trận Định Tuyến NekoBox"
            android:textColor="#A855F7"
            android:textStyle="bold" />

        <Switch
            android:id="@+id/switchGameVpn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:checked="true"
            android:text="🎮 Ép Game Đi Node Singapore (Ping 22ms)"
            android:textColor="#E2E8F0" />

        <Switch
            android:id="@+id/switchAiUs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:checked="true"
            android:text="🤖 ChatGPT / Claude Đi Node Mỹ"
            android:textColor="#E2E8F0" />

        <Button
            android:id="@+id/btnReloadNeko"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:backgroundTint="#7E22CE"
            android:text="📋 Chép Đè File Config & Khởi Động NekoBox"
            android:textSize="12sp" />

        <!-- 3. CHẶN APP & BĂNG THÔNG -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="3. Chặn App & Băng Thông"
            android:textColor="#F43F5E"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnBlockTiktok"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="#BE123C"
                android:text="🚫 Chặn TikTok"
                android:textSize="12sp" />

            <View
                android:layout_width="8dp"
                android:layout_height="0dp" />

            <Button
                android:id="@+id/btnUnblockTiktok"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="#059669"
                android:text="✅ Mở TikTok"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnCheckEmmc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:backgroundTint="#334155"
            android:text="💾 Kiểm Tra Dung Lượng 64GB eMMC"
            android:textSize="12sp" />

        <!-- 4. CONSOLE OUTPUT FEEDBACK -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Terminal STDOUT Feedback Từ Router:"
            android:textColor="#94A3B8"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvConsoleOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#020617"
            android:fontFamily="monospace"
            android:minHeight="120dp"
            android:padding="12dp"
            android:text="Sẵn sàng nhận lệnh..."
            android:textColor="#10B981"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
